---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const docs = await getCollection('docs');
---

<BaseLayout
  title="Home"
  description="Documentation and architectural opinions hub designed for autonomous AI agents and engineers."
>
  <div class="space-y-12">
    <!-- Hero Section -->
    <section class="space-y-4 pt-4 pb-2">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded bg-[var(--surface-card)] border border-[var(--border-subtle)] text-[var(--accent-primary)] text-xs font-mono">
        <span>🤖 AGENT-FIRST KNOWLEDGE HARNESS</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-[var(--text-primary)]">
        Agentic Docs
      </h1>
      <p class="text-lg text-[var(--text-muted)] max-w-2xl leading-relaxed">
        The source of truth for architectural opinions, tactile UI patterns, and engineering principles. Built for synthetic agents to ingest and human engineers to explore.
      </p>

      <div class="flex items-center gap-3 pt-2 flex-wrap">
        <a
          href="/docs/visual-aesthetic"
          class="tactile-keycap px-4 py-2 text-xs text-[var(--accent-primary)] font-semibold border-[var(--border-focus)]"
        >
          Read Aesthetic Manifesto →
        </a>
        <a
          href="/llms.txt"
          target="_blank"
          class="tactile-keycap px-4 py-2 text-xs text-[var(--accent-highlight)]"
        >
          Inspect /llms.txt ↗
        </a>
      </div>
    </section>

    <!-- Documents Grid -->
    <section class="space-y-6">
      <div class="flex items-center justify-between border-b border-[var(--border-subtle)] pb-3">
        <h2 class="text-lg font-bold font-mono text-[var(--text-primary)]">
          // Active Opinions & Research
        </h2>
        <span class="text-xs font-mono text-[var(--text-muted)]">{docs.length} Document(s)</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {docs.map((doc) => {
          const slug = doc.id.replace(/\.md$/, '');
          return (
            <div class="osl-card p-6 space-y-4 hover:border-[var(--accent-primary)] transition-all">
              <div class="flex items-center justify-between text-xs font-mono">
                <span class="text-[var(--accent-secondary)] uppercase tracking-wider">
                  [{doc.data.category}]
                </span>
                <span class="text-[var(--text-muted)]">{doc.data.publishedDate || 'Active'}</span>
              </div>

              <div class="space-y-1.5">
                <h3 class="text-xl font-bold text-[var(--text-primary)]">
                  <a href={`/docs/${slug}`} class="hover:text-[var(--accent-primary)] transition-colors">
                    {doc.data.title}
                  </a>
                </h3>
                <p class="text-xs text-[var(--text-muted)] leading-relaxed line-clamp-3">
                  {doc.data.description}
                </p>
              </div>

              <div class="pt-2 flex items-center justify-between text-xs font-mono border-t border-[var(--border-subtle)]">
                <a
                  href={`/docs/${slug}`}
                  class="text-[var(--accent-primary)] hover:underline flex items-center gap-1 font-semibold"
                >
                  Interactive Reader →
                </a>
                <a
                  href={`/docs/${slug}.md`}
                  target="_blank"
                  class="text-[var(--accent-highlight)] hover:underline"
                >
                  Raw .md ↗
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- Agent Quick-Connect Console Box -->
    <section class="p-6 rounded-lg bg-[var(--surface-card)] border border-[var(--border-subtle)] space-y-4 font-mono text-xs">
      <div class="flex items-center justify-between">
        <span class="text-[var(--accent-secondary)] font-bold">// AGENT QUICK-DISCOVERY HARNESS</span>
        <span class="text-[var(--text-muted)]">HTTP Content-Negotiation</span>
      </div>
      <p class="text-[var(--text-muted)] font-sans text-xs leading-relaxed">
        Autonomous agents can consume this entire site via the standard <code class="text-[var(--accent-highlight)]">/llms.txt</code> index, or fetch any document directly with pristine frontmatter by appending <code class="text-[var(--accent-highlight)]">.md</code> to the URL.
      </p>
      <div class="p-3 bg-[var(--canvas-bg)] border border-[var(--border-subtle)] rounded text-[var(--accent-success)] overflow-x-auto">
        <code>curl -s https://docs.tomasmed.dev/llms.txt</code>
      </div>
    </section>
  </div>
</BaseLayout>
