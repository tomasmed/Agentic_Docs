    "fix": "astro check"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/svelte": "^7.0.4",
    "astro": "^5.4.2",
    "svelte": "^5.20.2",
    "typescript": "^5.8.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^22.13.9",
    "tailwindcss": "^4.0.9",
    "vitest": "^3.0.7"
  }
}
